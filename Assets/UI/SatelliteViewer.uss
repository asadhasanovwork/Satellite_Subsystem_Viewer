.hud-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.hud-center-space {
    flex-grow: 1;
}

.hud-panel {
    background-color: rgba(7, 14, 28, 0.72);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(95, 155, 255, 0.35);
    border-right-color: rgba(95, 155, 255, 0.35);
    border-bottom-color: rgba(95, 155, 255, 0.35);
    border-left-color: rgba(95, 155, 255, 0.35);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.left-hud {
    width: 290px;
    min-width: 290px;
    max-width: 290px;
    height: 100%;
}

.right-hud {
    width: 360px;
    min-width: 360px;
    max-width: 360px;
    height: 100%;
}

.hud-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(233, 242, 255, 1);
    margin-bottom: 12px;
}

.detail-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(240, 246, 255, 1);
    margin-bottom: 10px;
}

.hud-block {
    margin-bottom: 12px;
}

.hud-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(150, 196, 255, 1);
    margin-bottom: 5px;
}

.detail-line {
    font-size: 12px;
    color: rgba(220, 231, 246, 1);
    margin-bottom: 4px;
}

.detail-description {
    font-size: 12px;
    color: rgba(223, 231, 242, 1);
    white-space: normal;
}

.hud-input {
    min-height: 32px;
}

.hud-button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.small-btn {
    width: 82px;
    min-width: 82px;
    max-width: 82px;
    height: 32px;
    min-height: 32px;
}

.list-block {
    flex-grow: 1;
}

.hud-list {
    flex-grow: 1;
    min-height: 430px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-left-color: rgba(255, 255, 255, 0.06);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hud-image {
    height: 155px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-left-color: rgba(255, 255, 255, 0.06);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hud-slider {
    margin-top: 2px;
}

.ops-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.op-btn {
    width: 48%;
    min-width: 48%;
    max-width: 48%;
    height: 34px;
    min-height: 34px;
    margin-bottom: 8px;
}

.hud-btn {
    background-color: rgba(255, 255, 255, 0.09);
    color: rgba(235, 242, 250, 1);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hud-btn:hover {
    background-color: rgba(82, 132, 220, 0.28);
}

.danger-btn {
    background-color: rgba(150, 52, 52, 0.28);
}

.danger-btn:hover {
    background-color: rgba(190, 65, 65, 0.36);
}

Label {
    color: rgba(223, 232, 245, 1);
}